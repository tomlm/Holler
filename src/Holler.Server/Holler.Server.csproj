<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Holler.Server</PackageId>
    <Version>0.9.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Description>Server side of Holler: the SignalR signaling hub and Blazor Server support for peer-to-peer WebRTC in Blazor.</Description>
    <Authors>Tom Laird-McConnell</Authors>
    <Company>Iciclecreek</Company>
    <PackageTags>blazor;webrtc;signalr;video;p2p</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tomlm/Holler</PackageProjectUrl>
    <PackageIconUrl>https://raw.githubusercontent.com/tomlm/Holler/main/icon.png</PackageIconUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/tomlm/Holler</RepositoryUrl>
    <Copyright>Tom Laird-McConnell All Rights Reserved</Copyright>
    <RootNamespace>Holler.Server</RootNamespace>
    <ContentTargetFolders>content</ContentTargetFolders>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../../icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Holler\Holler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Holler.Tests" />
  </ItemGroup>

</Project>
