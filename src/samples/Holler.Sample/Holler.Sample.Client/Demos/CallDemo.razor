@inherits HollerComponentBase

@* Rings this tab and shows accept/decline; normally you'd put this in your layout. *@
<HollerIncomingCall OnAccepted="call => _selected = call.RemoteUserId" />

<div class="row g-4">
    <div class="col-md-3">
        <h5>Online</h5>
        @if (!Holler.IsStarted)
        {
            <p class="text-muted">@(Error ?? "Connecting…")</p>
        }
        else if (Others.Count == 0)
        {
            <p class="text-muted">Nobody else is online. Sign in as someone else in another browser.</p>
        }
        <div class="list-group">
            @foreach (var user in Others)
            {
                <button type="button" class="list-group-item list-group-item-action @(user == _selected ? "active" : "")"
                        @onclick="() => _selected = user">
                    @user
                    @if (Holler.GetCall(user) is { } call)
                    {
                        <span class="badge text-bg-secondary ms-2">@call.State</span>
                    }
                </button>
            }
        </div>
    </div>

    <div class="col-md-9">
        @if (_selected is null)
        {
            <p class="text-muted">Pick someone to call.</p>
        }
        else
        {
            <HollerVideoCall @key="_selected" UserId="@_selected" />
            <h5 class="mt-3">Chat with @_selected</h5>
            <HollerChat UserId="@_selected" />
        }
    </div>
</div>

@code {
    private string? _selected;

    private IReadOnlyList<string> Others => Holler.OnlineUsers.Where(u => u != Holler.UserId).ToArray();
}
